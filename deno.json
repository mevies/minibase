{
  "name": "@minibase/core",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "check": "deno task versions:check && deno task sql:check && deno task architecture:check && deno task optimization:check && deno task compatibility:evidence:check && deno task quality:evidence:check && deno task docs:check && deno task benchmark:evidence:check && deno task soak:evidence:check && deno task bench:supabase:evidence:check && deno task s3:evidence:check && deno check src/**/*.ts tests/**/*.ts scripts/**/*.ts",
    "test": "deno test -A",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "probe:pglite": "deno run -A scripts/probe_pglite.ts",
    "sql:check": "deno run --allow-read scripts/check_sql_safety.ts",
    "architecture:check": "deno run --allow-read scripts/check_architecture.ts",
    "optimization:check": "deno run --allow-read --allow-run=git scripts/check_optimization_policy.ts",
    "versions:check": "deno run --allow-read --allow-run scripts/check_versions.ts",
    "docs:check": "deno run --allow-read scripts/check_documentation.ts",
    "compatibility:evidence:check": "deno run --allow-read scripts/check_compatibility_evidence.ts",
    "quality:evidence:check": "deno run --allow-read scripts/check_quality_evidence.ts",
    "verify:baseline": "deno run --allow-read --allow-run scripts/verify_baseline.ts",
    "test:postgres": "deno test -A tests/postgres_engine_test.ts tests/upgrade_postgres_test.ts tests/reset_s3_postgres_test.ts tests/backup_cross_engine_test.ts",
    "bench": "deno run -A scripts/benchmark.ts",
    "bench:postgres": "deno run -A scripts/benchmark.ts --engine postgres",
    "bench:supabase": "deno run -A scripts/supabase_docker_benchmark.ts",
    "bench:supabase:compare": "deno run --allow-read --allow-write scripts/compare_supabase_docker.ts",
    "bench:supabase:promote": "deno run --allow-read --allow-write scripts/promote_supabase_evidence.ts",
    "bench:supabase:evidence:check": "deno run --allow-read scripts/check_supabase_evidence.ts",
    "bench:compare": "deno run --allow-read scripts/compare_benchmarks.ts",
    "bench:gate": "deno run --allow-read=.benchmarks/local --allow-write=.benchmarks/local scripts/benchmark_gate.ts",
    "benchmark:evidence:check": "deno run --allow-read --allow-run=git scripts/check_benchmark_evidence.ts",
    "soak:pglite": "deno run -A scripts/soak.ts --engine pglite",
    "soak:postgres": "deno run -A scripts/soak.ts --engine postgres",
    "soak:promote": "deno run --allow-read --allow-write scripts/promote_soak_evidence.ts",
    "soak:evidence:check": "deno run --allow-read scripts/check_soak_evidence.ts",
    "s3:real:probe": "deno run --allow-env --allow-net --allow-read --allow-run=git --allow-write=.evidence/local scripts/s3_real_probe.ts",
    "s3:evidence:promote": "deno run --allow-read --allow-write scripts/promote_s3_evidence.ts",
    "s3:evidence:check": "deno run --allow-read scripts/check_s3_evidence.ts",
    "release:ready:check": "deno run --allow-read --allow-run=git scripts/check_release_readiness.ts",
    "release:build:embedded:windows-x64": "deno run -A scripts/build_release.ts",
    "release:smoke:embedded:windows-x64": "deno task release:build:embedded:windows-x64 && deno run -A scripts/smoke_release.ts",
    "release:build:embedded:linux-x64": "deno run -A scripts/build_release.ts --edition embedded --platform linux-x64",
    "release:smoke:embedded:linux-x64": "deno task release:build:embedded:linux-x64 && deno run -A scripts/smoke_release.ts --edition embedded --platform linux-x64",
    "release:build:embedded:macos-x64": "deno run -A scripts/build_release.ts --edition embedded --platform macos-x64",
    "release:smoke:embedded:macos-x64": "deno task release:build:embedded:macos-x64 && deno run -A scripts/smoke_release.ts --edition embedded --platform macos-x64",
    "release:build:embedded:macos-arm64": "deno run -A scripts/build_release.ts --edition embedded --platform macos-arm64",
    "release:smoke:embedded:macos-arm64": "deno task release:build:embedded:macos-arm64 && deno run -A scripts/smoke_release.ts --edition embedded --platform macos-arm64",
    "release:prepare:postgres:linux-x64": "deno run -A scripts/prepare_postgres_linux_runtime.ts",
    "release:prepare:postgres:macos-x64": "deno run -A scripts/prepare_postgres_macos_runtime.ts",
    "release:prepare:postgres:macos-arm64": "deno run -A scripts/prepare_postgres_macos_runtime.ts",
    "release:build:server:linux-x64": "deno run -A scripts/build_release.ts --edition server --platform linux-x64",
    "release:smoke:server:linux-x64": "deno task release:build:server:linux-x64 && deno run -A scripts/smoke_release.ts --edition server --platform linux-x64",
    "release:build:server:macos-x64": "deno run -A scripts/build_release.ts --edition server --platform macos-x64",
    "release:smoke:server:macos-x64": "deno task release:build:server:macos-x64 && deno run -A scripts/smoke_release.ts --edition server --platform macos-x64",
    "release:build:server:macos-arm64": "deno run -A scripts/build_release.ts --edition server --platform macos-arm64",
    "release:smoke:server:macos-arm64": "deno task release:build:server:macos-arm64 && deno run -A scripts/smoke_release.ts --edition server --platform macos-arm64",
    "release:build:server:windows-x64": "deno run -A scripts/build_release.ts --edition server",
    "release:smoke:server:windows-x64": "deno task release:build:server:windows-x64 && deno run -A scripts/smoke_release.ts --edition server"
  },
  "imports": {
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.5.4",
    "@supabase/server": "npm:@supabase/server@1.4.1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.110.9",
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/path": "jsr:@std/path@1.1.5",
    "smol-toml": "npm:smol-toml@1.7.0",
    "postgres": "npm:postgres@3.4.9"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "exclude": [
      ".idea",
      ".minibase"
    ],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "exclude": [
      "fixtures/supabase-cli-2.110.0-function"
    ]
  }
}
