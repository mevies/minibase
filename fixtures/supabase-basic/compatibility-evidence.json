        "supabaseServer.pglite.supported.context.admin-rest",
        "supabaseServer.pglite.supported.context.admin-storage",
        "supabaseServer.pglite.supported.context.admin-functions-invoke",
        "supabaseServer.pglite.supported.key.default",
        "supabaseServer.pglite.unsupported.key.named"
